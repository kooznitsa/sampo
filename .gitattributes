# По умолчанию все текстовые файлы → LF
* text=auto eol=lf

# Явно задаём для Python, JS, TS, CSS, HTML и т.д.
*.py   text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.css  text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh   text eol=lf
*.ini  text eol=lf
*.toml text eol=lf
*.xml  text eol=lf
*.txt  text eol=lf

# Отключаем преобразования для бинарников
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.tar  binary
*.exe  binary
*.dll  binary
*.so   binary
